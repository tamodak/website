# Copy to .env (chmod 600) and fill in. docker compose reads it from this directory.
# RUNBOOK.md explains each value.

# Let's Encrypt account email: expiry warnings and problems with the certificates.
ACME_EMAIL=

# The test API's host name. It is also what phones sign requests for (SPEC.md §4.2).
API_TEST_HOST=api.test.tamodak.org

# SHA-256 of the certificates Killit builds are signed with, comma-separated, as printed by
# `apksigner verify --print-certs` (colons allowed). The test server accepts both the release and
# the debug certificate (PLAN.md E-E9).
TEST_ATTESTATION_CERT_DIGESTS=

# Set to /run/secrets/fcm_service_account.json once secrets/fcm_service_account.json holds the
# Firebase service-account key. Empty runs the API without push.
TEST_FCM_CREDENTIALS_FILE=

# Backups (RUNBOOK.md, "Backups"). Set COMPOSE_PROFILES=backups once the bucket, the keys and the
# age public key are in place.
COMPOSE_PROFILES=
BACKUP_BUCKET=killit-backups
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=
# e.g. eu-frankfurt-1
OCI_REGION=
# Optional: a URL to request after every successful backup (e.g. a healthchecks.io check), so a
# backup that stops working raises an alert.
TEST_BACKUP_HEARTBEAT_URL=
